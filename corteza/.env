# Pin the patch release that matches the current docs series (2024.9).
# 2024.9.9 is the latest stable tag; 2024.9.10-dev.* is a development build.
DOMAIN=localhost:18080
VERSION=2024.9.9

DB_DSN=postgres://corteza:corteza@db:5432/corteza?sslmode=disable

HTTP_WEBAPP_ENABLED=true
HTTP_WEBAPP_LIST=admin,compose,workflow,reporter,tickets

ACTIONLOG_ENABLED=true

# Local-only secret. Replace before exposing the instance.
AUTH_JWT_SECRET=plexys-homework-local-jwt-secret-change-before-any-network-use
